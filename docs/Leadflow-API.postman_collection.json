{
  "info": {
    "_postman_id": "f1d8d6a0-3f2b-4d3c-9f64-6e8c2ef4b2a1",
    "name": "Leadflow API",
    "description": "Postman collection for the Leadflow mobile API. Run Login first; the test script stores the Sanctum token for protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://followup.slinggroups.in/api"
    },
    {
      "key": "email",
      "value": "admin@example.com"
    },
    {
      "key": "password",
      "value": "password"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "lead_id",
      "value": "1"
    },
    {
      "key": "lead_source_id",
      "value": "1"
    },
    {
      "key": "service_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "if (json.user && json.user.id) pm.collectionVariables.set('user_id', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/dashboard",
              "host": ["{{base_url}}"],
              "path": ["dashboard"]
            }
          }
        },
        {
          "name": "Today's follow-ups",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/followups/today",
              "host": ["{{base_url}}"],
              "path": ["followups", "today"]
            }
          }
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "List leads",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/leads?page=1&per_page=15&search=&status=&lead_source_id=",
              "host": ["{{base_url}}"],
              "path": ["leads"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "per_page", "value": "15"},
                {"key": "search", "value": ""},
                {"key": "status", "value": ""},
                {"key": "lead_source_id", "value": ""}
              ]
            }
          }
        },
        {
          "name": "Create lead",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('lead_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Neha Sharma\",\n  \"mobile_number\": \"9876543210\",\n  \"email\": \"neha@example.com\",\n  \"company_name\": \"Acme Retail\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"400001\",\n  \"lead_source_id\": {{lead_source_id}},\n  \"service_id\": {{service_id}},\n  \"status\": \"New\",\n  \"priority\": \"High\",\n  \"next_followup_at\": \"2026-09-20T14:30:00+05:30\",\n  \"remarks\": \"Asked for an app development estimate.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/leads",
              "host": ["{{base_url}}"],
              "path": ["leads"]
            }
          }
        },
        {
          "name": "Get lead",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}",
              "host": ["{{base_url}}"],
              "path": ["leads", "{{lead_id}}"]
            }
          }
        },
        {
          "name": "Update lead",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Neha Sharma\",\n  \"mobile_number\": \"9876543210\",\n  \"status\": \"Contacted\",\n  \"priority\": \"High\",\n  \"remarks\": \"Followed up by phone.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}",
              "host": ["{{base_url}}"],
              "path": ["leads", "{{lead_id}}"]
            }
          }
        },
        {
          "name": "Delete lead",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}",
              "host": ["{{base_url}}"],
              "path": ["leads", "{{lead_id}}"]
            }
          }
        },
        {
          "name": "Create lead with attachments (multipart)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "full_name", "value": "Neha Sharma", "type": "text"},
                {"key": "mobile_number", "value": "9876543211", "type": "text"},
                {"key": "status", "value": "New", "type": "text"},
                {"key": "priority", "value": "High", "type": "text"},
                {"key": "attachments[]", "type": "file", "src": ""}
              ]
            },
            "url": {
              "raw": "{{base_url}}/leads",
              "host": ["{{base_url}}"],
              "path": ["leads"]
            }
          }
        }
      ]
    },
    {
      "name": "Follow-ups",
      "item": [
        {
          "name": "Add follow-up",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "followup_at", "value": "2026-09-18T11:00:00+05:30", "type": "text"},
                {"key": "note", "value": "Discussed the proposal.", "type": "text"},
                {"key": "type", "value": "Call", "type": "text"},
                {"key": "next_followup_at", "value": "2026-09-21T15:00:00+05:30", "type": "text"},
                {"key": "status_after", "value": "Follow-up", "type": "text"},
                {"key": "attachment", "type": "file", "src": ""}
              ]
            },
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}/followups",
              "host": ["{{base_url}}"],
              "path": ["leads", "{{lead_id}}", "followups"]
            }
          }
        }
      ]
    },
    {
      "name": "Bulk import",
      "item": [
        {
          "name": "Import leads",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "file", "type": "file", "src": ""}
              ]
            },
            "url": {
              "raw": "{{base_url}}/leads/import",
              "host": ["{{base_url}}"],
              "path": ["leads", "import"]
            }
          }
        }
      ]
    },
    {
      "name": "Lead sources",
      "item": [
        {"name": "List sources", "request": {"method": "GET", "url": {"raw": "{{base_url}}/lead-sources", "host": ["{{base_url}}"], "path": ["lead-sources"]}}},
        {"name": "Get source", "request": {"method": "GET", "url": {"raw": "{{base_url}}/lead-sources/{{lead_source_id}}", "host": ["{{base_url}}"], "path": ["lead-sources", "{{lead_source_id}}"]}}},
        {"name": "Create source", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Google Ads\",\n  \"color\": \"#4DA3A7\"\n}", "options": {"raw": {"language": "json"}}}, "url": {"raw": "{{base_url}}/lead-sources", "host": ["{{base_url}}"], "path": ["lead-sources"]}}},
        {"name": "Update source", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Google Ads Updated\",\n  \"color\": \"#4DA3A7\"\n}", "options": {"raw": {"language": "json"}}}, "url": {"raw": "{{base_url}}/lead-sources/{{lead_source_id}}", "host": ["{{base_url}}"], "path": ["lead-sources", "{{lead_source_id}}"]}}},
        {"name": "Delete source", "request": {"method": "DELETE", "url": {"raw": "{{base_url}}/lead-sources/{{lead_source_id}}", "host": ["{{base_url}}"], "path": ["lead-sources", "{{lead_source_id}}"]}}}
      ]
    },
    {
      "name": "Services",
      "item": [
        {"name": "List services", "request": {"method": "GET", "url": {"raw": "{{base_url}}/services", "host": ["{{base_url}}"], "path": ["services"]}}},
        {"name": "Get service", "request": {"method": "GET", "url": {"raw": "{{base_url}}/services/{{service_id}}", "host": ["{{base_url}}"], "path": ["services", "{{service_id}}"]}}},
        {"name": "Create service", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"CRM Software\"\n}", "options": {"raw": {"language": "json"}}}, "url": {"raw": "{{base_url}}/services", "host": ["{{base_url}}"], "path": ["services"]}}},
        {"name": "Update service", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"CRM Software Updated\"\n}", "options": {"raw": {"language": "json"}}}, "url": {"raw": "{{base_url}}/services/{{service_id}}", "host": ["{{base_url}}"], "path": ["services", "{{service_id}}"]}}},
        {"name": "Delete service", "request": {"method": "DELETE", "url": {"raw": "{{base_url}}/services/{{service_id}}", "host": ["{{base_url}}"], "path": ["services", "{{service_id}}"]}}}
      ]
    }
  ]
}
